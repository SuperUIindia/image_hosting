{
  "name": "image-url-generator",
  "version": "1.0.0",
  "description": "AI-assisted Image URL Generator with React and Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"upload,vite\" -c \"cyan,blue\" \"node server.js\" \"vite\"",
    "dev:vite": "vite",
